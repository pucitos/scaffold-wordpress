# --- Impostazioni Generali del Progetto ---
# COMPOSE_PROJECT_NAME=my_actual_blog # Docker Compose usa il nome della directory di default.
                                      # Usato da Makefile per i prefissi dei progetti dev/prod.

# --- Credenziali Database (DA CAMBIARE PER OGNI PROGETTO!) ---
DB_ROOT_PASSWORD=changeme_db_root_password
DB_NAME=wordpress
DB_USER=wordpress_user
DB_PASSWORD=changeme_wordpress_password

# --- Impostazioni Sito WordPress (per produzione) ---
# Dominio di produzione del TUO progetto (es. mynewblog.com)
SITE_DOMAIN=yourprojectdomain.com
# Schema del sito (http o https)
SITE_SCHEME=https

# --- Chiavi di Sicurezza WordPress (FONDAMENTALE cambiarle per ogni nuovo progetto!) ---
# Genera nuove chiavi qui: https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# --- Configurazione Immagine Docker (per produzione) ---
# Modifica 'your-docker-registry' e 'your-project-name' con i dati del TUO progetto.
DOCKER_IMAGE_NAME=your-docker-registry/your-project-name
# Esempio: ghcr.io/pucitos/scaffold-wordpress
# DOCKER_IMAGE_NAME=ghcr.io/TUO_USERNAME_GITHUB/scaffold-wordpress

IMAGE_TAG=latest

# --- Impostazioni Traefik (per produzione docker-compose.yml) ---
# Nome del tuo certificate resolver in Traefik (es. letsencrypt, le, myresolver)
TRAEFIK_CERTRESOLVER=letsencrypt
# TRAEFIK_NETWORK=traefik-public # Nome della rete Docker usata da Traefik (se diversa da 'traefik-public')

# --- Impostazioni Sviluppo Locale (usate da docker-compose.override.yml e Makefile) ---
# Porta per accedere a WordPress in locale (http://localhost:8000)
DEV_WP_PORT=8000
# DEV_DB_PORT=33060 # Porta per accedere al DB in locale (se vuoi esporla)